{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "addLabels": [
        "{{manager}}",
    ],
    "extends": [
        "config:recommended",
        "customManagers:githubActionsVersions",
    ],
    "labels": [
        "dependencies",
    ],
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            // essentia-tensorflow ships wheels for one CPython minor
            // only, so a minor bump fails to resolve until it catches
            // up. Approve from the dashboard once PyPI lists a wheel
            // for the new minor.
            "matchDepNames": [
                "python",
            ],
            "matchUpdateTypes": [
                "minor",
                "major",
            ],
            "dependencyDashboardApproval": true,
        },
    ],
    "prConcurrentLimit": 10,
    "prHourlyLimit": 5,
    "schedule": [
        "* * 20-23 * *",
    ],
    "vulnerabilityAlerts": {
        "addLabels": [
            "security",
        ],
        "minimumReleaseAge": "0 days",
        "schedule": [
            "at any time",
        ],
    },
}
